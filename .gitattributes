# Normalise to LF in the repository. The working tree follows .editorconfig,
# and CI runs on Linux — without this, Windows checkouts commit CRLF and every
# diff becomes noise.
* text=auto eol=lf

# Binary — never touch these
*.png  binary
*.jpg  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ico  binary
*.pdf  binary
