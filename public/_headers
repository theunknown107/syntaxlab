# Cloudflare Pages headers — 17_DEPLOYMENT.md §4
# Copied verbatim into dist/. These are the production security headers;
# the meta CSP in index.html is the development-time equivalent.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/theme-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker runs in its own context with its own CSP, taken from the
# headers on this response — it does not inherit the page's. The site-wide
# policy above sets `connect-src 'none'`, which is right for the page (it makes
# no requests) and fatal here: Workbox precaches by calling fetch() during
# install, so under that policy the worker silently never activates and no
# asset is ever cached. Measured, A/B, on the real build.
#
# This is a *narrower* policy for a different context, not a relaxation of the
# page's. The worker needs exactly two things: to importScripts its own Workbox
# chunk, and to fetch same-origin assets it is about to cache. Everything else
# stays denied — there is no style, image, font or frame in a service worker.
/sw.js
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'
  Cache-Control: public, max-age=0, must-revalidate

# Imported by sw.js via importScripts, so it needs the same execution context
# rules. Content-hashed, therefore safe to cache immutably.
/workbox-*.js
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
